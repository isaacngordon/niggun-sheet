# Google Sheets API Configuration
# Required for fetching songs from Google Sheets in production
# If not set, the application will fall back to the local CSV file (data/songs.csv)

# Your Google Sheets spreadsheet ID
# Example: If your sheet URL is https://docs.google.com/spreadsheets/d/1ABC123.../edit
# Then your GOOGLE_SHEETS_ID is: 1ABC123...
GOOGLE_SHEETS_ID=

# Your Google API Key for accessing Google Sheets API
# Get this from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=

# The range of cells to fetch from the sheet (optional, defaults to Sheet1!A:F1000)
# Format: SheetName!StartCell:EndCell
SHEET_RANGE=Sheet1!A:F1000
