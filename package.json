{
  "name": "niggun-sheet",
  "version": "1.0.1",
  "description": "",
  "main": "server.js",
  "scripts": {
    "preinstall": "npm install node-gyp@latest",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:old": "nodemon server.js -e html,js,css,csv",
    "start:old": "node server.js",
    "db-migrate": "node data/migrate.js",
    "db-seed": "node data/seed.js data/songs.csv",
    "db-backup": "prefix=$(echo $(( $(ls data/backups | grep -o '^[0-9]*' | sort -n | tail -1) + 1 ))); timestamp=$(date +\"%Y%m%d_%H%M%S\"); filepath=\"data/backups/${prefix}_${timestamp}_backup.sql\"; sqlite3 db.db .dump > $filepath; echo $filepath"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "googleapis": "^159.0.0",
    "next": "^15.5.3",
    "node-gyp": "^12.1.0",
    "packery": "^3.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "serverless-http": "^3.2.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "nodemon": "^3.0.2"
  }
}
