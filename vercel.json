{
  "functions": {
    "api/songs.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/songs",
      "destination": "/api/songs"
    },
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ]
}

{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|ttf|woff|woff2))",
      "dest": "/public/$1"
    }
  ],
  "functions": {
    "api/songs.js": {
      "maxDuration": 15
    }
  }
}
